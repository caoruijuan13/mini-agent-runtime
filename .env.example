# ═══════════════════════════════════════════════════════════════
#  mini-agent-runtime — 环境变量配置
# ═══════════════════════════════════════════════════════════════
#  复制本文件为 .env 并填入你的 API Key:
#    cp .env.example .env
#
#  然后根据需要修改下方配置。

# ─── 服务器配置 ────────────────────────────────────────────────

HOST=127.0.0.1
PORT=3000

# ─── LLM 提供商 ───────────────────────────────────────────────
# 可选值: "openai" (真实大模型) 或 "mock" (模拟，无需 API Key)
LLM_PROVIDER=openai

# ─── 大模型 API 配置 ──────────────────────────────────────────
#
# 下方提供了主流大模型的预设，取消注释你想要使用的那一组即可。
# 所有兼容 OpenAI API 格式的大模型均可接入。
#
# ⚠️  必须设置 OPENAI_API_KEY，否则服务启动会报错。

# ┌───────────────────────────────────────────────────────────┐
# │  OpenAI (GPT-4o / GPT-4o-mini)                           │
# └───────────────────────────────────────────────────────────┘
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
MODEL=gpt-4o-mini

# ┌───────────────────────────────────────────────────────────┐
# │  通义千问 / Qwen (DashScope)                              │
# │  获取 Key: https://dashscope.console.aliyun.com/          │
# └───────────────────────────────────────────────────────────┘
# OPENAI_API_KEY=sk-your-dashscope-key
# OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# MODEL=qwen-plus

# ┌───────────────────────────────────────────────────────────┐
# │  月之暗面 / Moonshot (Kimi)                                │
# │  获取 Key: https://platform.moonshot.cn/                   │
# └───────────────────────────────────────────────────────────┘
# OPENAI_API_KEY=sk-your-moonshot-key
# OPENAI_BASE_URL=https://api.moonshot.cn/v1
# MODEL=moonshot-v1-8k

# ┌───────────────────────────────────────────────────────────┐
# │  DeepSeek                                                  │
# │  获取 Key: https://platform.deepseek.com/                  │
# └───────────────────────────────────────────────────────────┘
# OPENAI_API_KEY=sk-your-deepseek-key
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# MODEL=deepseek-chat

# ┌───────────────────────────────────────────────────────────┐
# │  零一万物 / Yi                                             │
# │  获取 Key: https://platform.lingyiwanwu.com/               │
# └───────────────────────────────────────────────────────────┘
# OPENAI_API_KEY=sk-your-yi-key
# OPENAI_BASE_URL=https://api.lingyiwanwu.com/v1
# MODEL=yi-large

# ┌───────────────────────────────────────────────────────────┐
# │  智谱 AI / GLM (ChatGLM)                                  │
# │  获取 Key: https://open.bigmodel.cn/                       │
# └───────────────────────────────────────────────────────────┘
# OPENAI_API_KEY=your-glm-key
# OPENAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# MODEL=glm-4-flash

# ┌───────────────────────────────────────────────────────────┐
# │  硅基流动 / SiliconFlow                                    │
# │  获取 Key: https://siliconflow.cn/                         │
# │  支持多种开源模型: Qwen2.5, DeepSeek, GLM-4 等             │
# └───────────────────────────────────────────────────────────┘
# OPENAI_API_KEY=sk-your-siliconflow-key
# OPENAI_BASE_URL=https://api.siliconflow.cn/v1
# MODEL=Qwen/Qwen2.5-7B-Instruct

# ┌───────────────────────────────────────────────────────────┐
# │  Ollama (本地运行，无需 API Key)                           │
# │  安装: https://ollama.com/download                         │
# │  启动: ollama serve                                        │
# │  拉取: ollama pull qwen2.5:7b                             │
# └───────────────────────────────────────────────────────────┘
# OPENAI_API_KEY=ollama
# OPENAI_BASE_URL=http://127.0.0.1:11434/v1
# MODEL=qwen2.5:7b

# ┌───────────────────────────────────────────────────────────┐
# │  Groq (超快推理，免费额度)                                 │
# │  获取 Key: https://console.groq.com/                       │
# └───────────────────────────────────────────────────────────┘
# OPENAI_API_KEY=gsk-your-groq-key
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# MODEL=llama-3.3-70b-versatile

# ─── 模型参数 ─────────────────────────────────────────────────

# 最大生成 token 数 (1 ~ 128000)
MAX_TOKENS=2048

# 温度 (0.0 ~ 2.0，越高越随机，越低越确定)
TEMPERATURE=0.7

# ─── 日志级别 ─────────────────────────────────────────────────
# 可选: trace, debug, info, warn, error
RUST_LOG=mini_agent_server=info
